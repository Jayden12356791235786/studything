rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomPath(id) { return /databases/$(database)/documents/rooms/$(id); }
    function canSeeRoom(id) {
      return signedIn() &&
        (request.auth.uid in get(roomPath(id)).data.memberUids ||
         request.auth.uid in get(roomPath(id)).data.inviteUids);
    }

    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username.lower() == handle
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,18}$')
        && request.resource.data.keys().hasOnly(['uid', 'username']);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,18}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);
      allow delete: if false;
    }

    match /rooms/{id} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.inviteUids.size() <= 9
        && request.resource.data.status == 'lobby';
      allow get: if canSeeRoom(id);
      allow list: if false;
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'status', 'currentIndex', 'lastAnswer'])
          && request.resource.data.memberUids.size() <= 10
          && request.resource.data.members.size() <= 10
          && request.resource.data.inviteUids.size() <= 9) ||
        (request.auth.uid in resource.data.inviteUids
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && request.auth.uid in request.resource.data.memberUids
          && resource.data.memberUids.size() < 10
          && request.resource.data.memberUids.size() <= 10
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1)
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /invitations/{id} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(roomPath(request.resource.data.roomId)).data.hostUid == request.auth.uid
        && request.resource.data.toUid in get(roomPath(request.resource.data.roomId)).data.inviteUids;
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if false;
    }
  }
}
